# Copy to .env and fill in; .env is ignored by git.
# Flutter reads it with: flutter run --dart-define-from-file=.env

# Backend root, must end with a slash.
API_BASE_URL=https://mderp.uz/
# Accept the API host's certificate even when it cannot be verified.
TRUST_API_HOST_CERTIFICATE=true
# Simulated RFID reader for emulators and phones without a UHF module.
FAKE_RFID=false

# Only for tool/api_probe.py, not used by the app.
RFID_API_LOGIN=
RFID_API_PASSWORD=

# Not used by the app; kept here so the keys are not lost.
YANDEX_API_KEY=
GEOCODER_API_KEY=
